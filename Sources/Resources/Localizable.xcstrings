    "Family and friends in the same room, over Wi-Fi or Bluetooth. No account needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family and friends in the same room, over Wi-Fi or Bluetooth. No account needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семья и друзья в одной комнате, через Wi-Fi или Bluetooth. Аккаунт не нужен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familie und Freunde im selben Raum, über WLAN oder Bluetooth. Kein Account nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Famille et amis dans la même pièce, en Wi-Fi ou Bluetooth. Aucun compte requis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Familia y amigos en la misma habitación, por Wi-Fi o Bluetooth. No hace falta cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Famiglia e amici nella stessa stanza, via Wi-Fi o Bluetooth. Nessun account necessario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Família e amigos no mesmo cômodo, por Wi-Fi ou Bluetooth. Não precisa de conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ部屋にいる家族や友達と、Wi-FiまたはBluetoothで。アカウントは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 방에 있는 가족, 친구와 Wi-Fi 또는 Bluetooth로. 계정이 필요 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一房间里的家人和朋友，通过无线局域网或蓝牙连接，无需账户。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครอบครัวและเพื่อนในห้องเดียวกัน ผ่าน Wi-Fi หรือ Bluetooth ไม่ต้องใช้บัญชี"
          }
        }
      }
    },
