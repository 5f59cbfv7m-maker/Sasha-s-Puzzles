    "They are also removed on your other devices that use the same iCloud account.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они удалятся и на других ваших устройствах с той же учётной записью iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden auch auf deinen anderen Geräten mit demselben iCloud-Account gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles seront aussi supprimées sur vos autres appareils utilisant le même compte iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminarán en tus otros dispositivos con la misma cuenta de iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati anche sugli altri dispositivi con lo stesso account iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles também serão apagados nos seus outros aparelhos com a mesma conta do iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ iCloud アカウントを使っているほかのデバイスからも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 iCloud 계정을 사용하는 다른 기기에서도 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一 iCloud 账户的其他设备上的数据也会一并删除。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะถูกลบในอุปกรณ์อื่นของคุณที่ใช้บัญชี iCloud เดียวกันด้วย"
          }
        }
      }
    },
