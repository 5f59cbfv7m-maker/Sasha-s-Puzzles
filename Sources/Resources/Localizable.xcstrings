    "The table is open. On the other device, tap the two figures in the library.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table is open. On the other device, tap the two figures in the library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стол открыт. На другом устройстве нажмите в библиотеке на две фигурки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch ist offen. Tippe auf dem anderen Gerät in der Bibliothek auf die zwei Figuren."
          }
        },
        "fr": {
