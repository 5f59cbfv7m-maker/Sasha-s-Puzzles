    "Only pictures from the library can be shared: the others do not have your photos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only pictures from the library can be shared: the others do not have your photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе можно собирать только картинки из библиотеки: ваших фото у других нет."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam gehen nur Bilder aus der Bibliothek: Die anderen haben deine Fotos nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les images de la bibliothèque se partagent : les autres n’ont pas vos photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden compartir imágenes de la biblioteca: los demás no tienen tus fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si possono condividere solo le immagini della libreria: gli altri non hanno le tue foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só dá para compartilhar imagens da biblioteca: os outros não têm as suas fotos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に遊べるのはライブラリの写真だけです。ほかの人はあなたの写真を持っていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 그림만 함께할 수 있어요. 다른 사람에게는 내 사진이 없기 때문이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能共享图库中的图片：其他人没有你的照片。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นด้วยกันได้เฉพาะภาพในคลังภาพ เพราะคนอื่นไม่มีรูปของคุณ"
          }
        }
      }
    },
