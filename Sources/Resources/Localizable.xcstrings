    "All built-in pictures are photographs from Unsplash. Thank you to the photographers!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All built-in pictures are photographs from Unsplash. Thank you to the photographers!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все встроенные картинки — фотографии с Unsplash. Спасибо фотографам!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle mitgelieferten Bilder sind Fotos von Unsplash. Danke an die Fotografinnen und Fotografen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les images intégrées sont des photos d’Unsplash. Merci aux photographes !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las imágenes incluidas son fotos de Unsplash. ¡Gracias a los fotógrafos!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le immagini incluse sono foto di Unsplash. Grazie ai fotografi!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as imagens incluídas são fotos do Unsplash. Obrigado aos fotógrafos!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵の写真はすべて Unsplash のものです。写真家の皆さんに感謝します！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 사진은 모두 Unsplash의 사진입니다. 사진작가분들께 감사드립니다!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内置图片均为来自 Unsplash 的照片。感谢各位摄影师！"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพในตัวทั้งหมดเป็นภาพถ่ายจาก Unsplash ขอขอบคุณช่างภาพทุกคน!"
          }
        }
      }
    },
