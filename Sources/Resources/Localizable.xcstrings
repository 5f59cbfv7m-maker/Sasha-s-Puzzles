    "Sign in to Game Center in the system settings to compare results with friends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Game Center in the system settings to compare results with friends."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в Game Center в системных настройках, чтобы сравнивать результаты с друзьями."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Systemeinstellungen bei Game Center an, um Ergebnisse mit Freunden zu vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Game Center dans les réglages du système pour comparer vos résultats avec vos amis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Game Center en los ajustes del sistema para comparar resultados con tus amigos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a Game Center nelle impostazioni di sistema per confrontare i risultati con gli amici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no Game Center nos ajustes do sistema para comparar resultados com amigos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達と結果を比べるには、システム設定でGame Centerにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구와 기록을 비교하려면 시스템 설정에서 Game Center에 로그인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中登录 Game Center，即可与好友比较成绩。"
          }
        }
      }
    },
