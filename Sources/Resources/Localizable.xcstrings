    "Invite friends anywhere. Each player needs their own Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite friends anywhere. Each player needs their own Apple Account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашайте друзей, где бы они ни были. Каждому игроку нужен свой Аккаунт Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Freunde von überall ein. Alle brauchen einen eigenen Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez des amis où qu’ils soient. Chaque joueur doit avoir son propre compte Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a amigos estén donde estén. Cada jugador necesita su propia cuenta de Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
