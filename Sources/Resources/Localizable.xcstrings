    },
    "A piece pulls itself into place. The hint highlights the next step — it can be switched off in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A piece pulls itself into place. The hint highlights the next step — it can be switched off in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деталь сама притягивается к своему месту. Подсказка подсвечивает следующий шаг — можно выключить в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil zieht sich selbst an seinen Platz. Der Tipp hebt den nächsten Schritt hervor – in den Einstellungen abschaltbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pièce se met d’elle-même en place. L’indice éclaire la prochaine étape — désactivable dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pieza se coloca sola en su sitio. La pista resalta el siguiente paso; puedes desactivarla en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pezzo si sistema da solo al suo posto. Il suggerimento evidenzia il passo successivo: si può disattivare nelle Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A peça se puxa para o lugar certo. A dica destaca o próximo passo — dá para desligar nos Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピースは自分から正しい位置に収まります。ヒントは次の一手を示します。設定でオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조각이 스스로 제자리를 찾아갑니다. 힌트는 다음 단계를 표시하며, 설정에서 끌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拼块会自动吸附到位。提示会高亮下一步，可在设置中关闭。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชิ้นส่วนจะดูดเข้าที่เอง คำใบ้จะไฮไลต์ขั้นต่อไป — ปิดได้ในการตั้งค่า"
          }
        }
      }
    },
