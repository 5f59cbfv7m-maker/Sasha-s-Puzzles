    "Real lock geometry: every cut exists once, so the pieces meet without gaps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real lock geometry: every cut exists once, so the pieces meet without gaps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящая геометрия замков: каждый разрез существует один раз, поэтому детали сходятся без зазоров."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte Verzahnung: Jeder Schnitt existiert nur einmal, die Teile schließen lückenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De vrais tenons : chaque découpe n’existe qu’une fois, les pièces s’assemblent sans jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encajes reales: cada corte existe una sola vez, así que las piezas se unen sin huecos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incastri veri: ogni taglio esiste una sola volta, così i pezzi combaciano senza spazi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixes reais: cada corte existe uma só vez, então as peças se unem sem folgas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本物の凹凸：切り込みは一つずつしか存在しないので、ピースはすき間なく合わさります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진짜 요철: 모든 절단선은 하나뿐이라 조각이 틈 없이 맞물립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实的凹凸卡扣：每条切线只有一条，拼块严丝合缝。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอยต่อเหมือนจริง: ทุกรอยตัดมีเพียงครั้งเดียว ชิ้นส่วนจึงประกบกันสนิทไม่มีช่องว่าง"
          }
        }
      }
    },
